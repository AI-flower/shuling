# =================================================================
# 用户运行时数据 — 每个用户自己生成，绝不能跟随仓库分发
# =================================================================

# Skill 运行配置（含 MCP_URL、可选 API Key 等）
config/runtime.env
config/state.json

# SQLite 数据库
data/*.db
data/*.db-shm
data/*.db-wal

# 个人画像与偏好
knowledge-base/profile.json
knowledge-base/preferences.json
knowledge-base/patterns.md
knowledge-base/anti-patterns.md
knowledge-base/evolution-log.md
knowledge-base/reviews/
knowledge-base/README.md

# v3.0+ 用户态（agent/ 内核）
agent/config/runtime.env
agent/config/state.json
agent/config/.layout-v3.done
agent/data/*.db
agent/data/*.db-shm
agent/data/*.db-wal
agent/data/*.db-journal
agent/data/.schema-degraded.lock
agent/data/external-intel-counters.json
agent/knowledge-base/external-signals/*.json
agent/knowledge-base/profile.json
agent/knowledge-base/preferences.json
agent/knowledge-base/patterns.md
agent/knowledge-base/anti-patterns.md
agent/knowledge-base/image-patterns.md
agent/knowledge-base/image-anti-patterns.md
agent/knowledge-base/evolution-log.md
agent/knowledge-base/reviews/
agent/knowledge-base/audit-*.md
agent/knowledge-base/audit-*.json

# =================================================================
# 临时输出
# =================================================================
/tmp/xhs-post/
*.log
*.bak
*.old
*-backup-*

# =================================================================
# 平台/IDE 本地数据（不属于 skill 本身）
# =================================================================
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.session-recorder/
.claude/

# =================================================================
# Python / Node 构建产物
# =================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
node_modules/
.npm/

# 带时间戳的备份文件（如 xhs.sh.bak.20260421_023540）
*.bak.*

# v2.4.0 wip artifact
.playwright-mcp/

# v3.1 Account Safety Layer（用户态）
agent/config/account-safety.json
agent/config/account-safety-state.json
agent/config/approvals/*
!agent/config/approvals/.gitkeep
agent/knowledge-base/external-signals/*
!agent/knowledge-base/external-signals/.gitkeep
