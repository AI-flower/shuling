version: "2.2.0"
codename: "Existing Creator Support"
released: "2026-04-21"

# ─── 版本号语义: BRAIN.HANDS.CALIB ──────────────────────────────────
#
# 升级 SOP: 详见 RELEASING.md
# 用户升级步骤: 详见 UPGRADE.md
# 变更历史:       详见 CHANGELOG.md
#
# BRAIN: SKILL.md 核心流程重构 / 自进化算法换代 / 业务能力跃迁
# HANDS: scripts/ 新增或重写 / DB schema 迁移 / MCP 接口替换
# CALIB: 阈值/关键词/节流参数调整 / bugfix / prompt 微调
#
# 版本位决策（本版 v2.2.0）:
#   - SKILL.md 新增 §0c 分支（老博主接入），为 additive 扩展，**不改变** 原有流程与算法
#   - 算法层零变化（preference_learning/confidence/drafting/image_gen 保持 v2.1.3）
#   - 主要是 HANDS 扩展：新脚本 + 新 DB 字段 + 新表 + 新 schema
#   - 遂定 HANDS +1 → v2.2.0。如果未来对 §0c 做算法化改造（如自动聚类替代 AI 聚类），视为 BRAIN +1

breaking_change_policy:
  brain:
    breaking: true
    description: "BRAIN +1 视为 major，可能改变 AI 行为方式。UPGRADE.md 必须给出迁移步骤；老用户需显式迁移。"
    requires_migration: true
  hands:
    breaking: false
    description: "HANDS +1 视为 minor，脚本/DB/接口扩展。一般向后兼容；如有 DB schema 变化需跑 install.sh 或 db.sh init。"
    requires_migration: maybe
  calib:
    breaking: false
    description: "CALIB +1 视为 patch，阈值/文档/bugfix。无 breaking，用户可无感升级。"
    requires_migration: false

brain:
  skill_md_sections: [0a, 0b, 0c, 0, 1, 2, 3, 4, 5, 6, 7, 8]
  algorithms:
    preference_learning: "bayesian-laplace-v1"
    exploration: "epsilon-greedy-7day"
    confidence: "concentration-x-sample-factor"
    drafting: "redink-dual-step-v1"
    image_gen: "two-stage-cover-reference-v1"
    existing_creator_onboarding: "v2.2.0-mvp"      # v2.2.0 新增：AI 驱动的画像反推 + patterns 种子挖掘 + 偏好 bootstrap

hands:
  mcp_tools:
    - search_feeds
    - get_feed_detail
    - list_feeds
    - publish_content
    - post_comment_to_feed
    - user_profile
    - check_login_status
    - get_login_qrcode
    - import_cookie
  db_tables:
    - posts
    - post_metrics
    - user_choices
    - topic_candidates
    - comment_insights
    - note_diagnosis
    - generated_images
    - request_log
    - historical_stats                             # v2.2.0 新增
  post_sources:                                    # v2.2.0 新增：posts.source 字段
    - shuling
    - imported
    - manual
  platforms:
    - hermes
    - claude-code
    - codex
  scripts:
    - xhs.sh
    - db.sh
    - fetch-metrics.sh
    - fetch-comments.sh
    - fetch-post-data.sh
    - image.py
    - noterx-diagnose.sh
    - preflight.py
    - screenshot.cjs
    - import-existing.sh                           # v2.2.0 新增
    - audit-report.sh                              # v2.2.0 新增
  installer:
    mode: "install + upgrade + check + dry-run + creator-mode"   # v2.2.0 起 --mode=existing-creator
    migrations_dir: "migrations"
  schemas:
    - state.schema.json
    - profile.schema.json
    - preferences.schema.json
    - audit-report.schema.json                     # v2.2.0 新增

calib:
  observability: "request-log-v1"
  throttle_profile: "v1-conservative"
  quota_profile: "v1-conservative"
  content_rules: "2026-04-17"
  emoji_dict_version: "v1"
  spam_keywords_version: "v1"
  docs_format: "keep-a-changelog + upgrade-guide + releasing-sop"
  onboarding_polish: "v2.1.3"
  existing_creator_feature: "v2.2.0-mvp"           # 本版引入，完整路径见 docs/features/existing-creator-onboarding.md
