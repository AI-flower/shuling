version: "2.1.3"
codename: "Friendly Onboarding"
released: "2026-04-21"

# ─── 版本号语义: BRAIN.HANDS.CALIB ──────────────────────────────────
#
# 升级 SOP: 详见 RELEASING.md
# 用户升级步骤: 详见 UPGRADE.md
# 变更历史:       详见 CHANGELOG.md
#
# BRAIN: SKILL.md 核心流程重构 / 自进化算法换代 / 业务能力跃迁
# HANDS: scripts/ 新增或重写 / DB schema 迁移 / MCP 接口替换
# CALIB: 阈值/关键词/节流参数调整 / bugfix / prompt 微调

breaking_change_policy:
  brain:
    breaking: true
    description: "BRAIN +1 视为 major，可能改变 AI 行为方式。UPGRADE.md 必须给出迁移步骤；老用户需显式迁移。"
    requires_migration: true
  hands:
    breaking: false
    description: "HANDS +1 视为 minor，脚本/DB/接口扩展。一般向后兼容；如有 DB schema 变化需跑 install.sh 或 db.sh init。"
    requires_migration: maybe
  calib:
    breaking: false
    description: "CALIB +1 视为 patch，阈值/文档/bugfix。无 breaking，用户可无感升级。"
    requires_migration: false

brain:
  skill_md_sections: [0a, 0b, 0, 1, 2, 3, 4, 5, 6, 7, 8]
  algorithms:
    preference_learning: "bayesian-laplace-v1"
    exploration: "epsilon-greedy-7day"
    confidence: "concentration-x-sample-factor"
    drafting: "redink-dual-step-v1"
    image_gen: "two-stage-cover-reference-v1"

hands:
  mcp_tools:
    - search_feeds
    - get_feed_detail
    - list_feeds
    - publish_content
    - post_comment_to_feed
    - user_profile
    - check_login_status
    - get_login_qrcode
    - import_cookie
  db_tables:
    - posts
    - post_metrics
    - user_choices
    - topic_candidates
    - comment_insights
    - note_diagnosis
    - generated_images
    - request_log
  platforms:
    - hermes
    - claude-code
    - codex
  scripts:
    - xhs.sh
    - db.sh
    - fetch-metrics.sh
    - fetch-comments.sh
    - fetch-post-data.sh
    - image.py
    - noterx-diagnose.sh
    - preflight.py
    - screenshot.cjs
  installer:
    mode: "install + upgrade + check + dry-run"   # v2.1.3 起 install.sh 支持 --check/--dry-run/--yes/--target
    migrations_dir: "migrations"
  schemas:                                         # v2.1.3 新增：AI 写入前自校验
    - state.schema.json
    - profile.schema.json
    - preferences.schema.json

calib:
  observability: "request-log-v1"
  throttle_profile: "v1-conservative"
  quota_profile: "v1-conservative"
  content_rules: "2026-04-17"
  emoji_dict_version: "v1"
  spam_keywords_version: "v1"
  docs_format: "keep-a-changelog + upgrade-guide + releasing-sop"
  onboarding_polish: "v2.1.3"                      # mcp-setup 重写 + cookie 图文指引 + preflight --human
