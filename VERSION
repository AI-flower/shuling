version: "2.4.2"
codename: "Source-Target Isolation Patch"
released: "2026-04-23"

# ─── 版本号语义: BRAIN.HANDS.CALIB ──────────────────────────────────
#
# 升级 SOP: 详见 RELEASING.md
# 用户升级步骤: 详见 UPGRADE.md
# 变更历史:       详见 CHANGELOG.md
#
# BRAIN: SKILL.md 核心流程重构 / 自进化算法换代 / 业务能力跃迁
# HANDS: scripts/ 新增或重写 / DB schema 迁移 / MCP 接口替换
# CALIB: 阈值/关键词/节流参数调整 / bugfix / prompt 微调
#
# 版本位决策（本版 v2.4.2）:
#   - SKILL.md 完全不动；业务能力 / 算法 / MCP 接口零变化；纯 bugfix
#   - 社区二次验证复盘 5 处 source-target 路径混淆修复：
#     1. install.sh _runtime_env_set 改 force override (MCP_URL 不再被模板默认值顶掉)
#     2. install.sh §7.5 每 target 循环追加 db.sh init (target DB 真实初始化 + __migrations)
#     3. install.sh ua_step_migrations 传 SHULING_DB=$target/data/xhs.db
#        (migrations 写入 target DB, 不再误写源仓库 DB)
#     4. db.sh 支持 SHULING_DB env var override (允许调用方显式指定 DB 路径)
#     5. _guard.sh 调 db.sh init 时透传 SHULING_DB (target DB 不存在时, init 目标正确)
#   - 附赠: ua_step_preflight 判定放宽 (exit 1/2 为运行时配置未就绪, 不是 upgrade 失败)
#   - 新增: scripts/pre-submit-verify.sh 21 项本地回归套件 (预演社区 verifier 行为)
#   - 遂定 CALIB +1 → v2.4.2

breaking_change_policy:
  brain:
    breaking: true
    description: "BRAIN +1 视为 major，可能改变 AI 行为方式。UPGRADE.md 必须给出迁移步骤；老用户需显式迁移。"
    requires_migration: true
  hands:
    breaking: false
    description: "HANDS +1 视为 minor，脚本/DB/接口扩展。一般向后兼容；如有 DB schema 变化需跑 install.sh 或 db.sh init。"
    requires_migration: maybe
  calib:
    breaking: false
    description: "CALIB +1 视为 patch，阈值/文档/bugfix。无 breaking，用户可无感升级。"
    requires_migration: false

brain:
  skill_md_sections: [0a, 0b, 0c, 0, 1, 2, 3, 4, 5, 6, 7, 8]
  algorithms:
    preference_learning: "bayesian-laplace-v1"
    exploration: "epsilon-greedy-7day"
    confidence: "concentration-x-sample-factor"
    drafting: "redink-dual-step-v1"
    image_gen: "two-stage-cover-reference-v1"
    existing_creator_onboarding: "v2.2.0-mvp"

hands:
  mcp_tools:
    - search_feeds
    - get_feed_detail
    - list_feeds
    - publish_content
    - post_comment_to_feed
    - user_profile
    - check_login_status
    - get_login_qrcode
    - import_cookie
  db_tables:
    - posts
    - post_metrics
    - user_choices
    - topic_candidates
    - comment_insights
    - note_diagnosis
    - generated_images
    - request_log
    - historical_stats
    - __migrations                                 # v2.4.0 新增：migration 应用台账
  post_sources:
    - shuling
    - imported
    - manual
  platforms:
    - hermes
    - claude-code
    - codex
  scripts:
    - xhs.sh
    - db.sh
    - fetch-metrics.sh
    - fetch-comments.sh
    - fetch-post-data.sh
    - image.py
    - noterx-diagnose.sh
    - preflight.py
    - screenshot.cjs
    - import-existing.sh
    - audit-report.sh
    - validate.py                                  # v2.4.0 新增：schemas JSON schema drift 校验
  installer:
    mode: "install + upgrade + check + dry-run + creator-mode + upgrade-all"  # v2.4.0 新增：upgrade-all agent-first 聚合器
    migrations_dir: "migrations"
    upgrade_hooks_dir: "upgrade-hooks"              # v2.4.0 新增
  schemas:
    - state.schema.json
    - profile.schema.json
    - preferences.schema.json
    - audit-report.schema.json
  upgrade_hooks:                                   # v2.4.0 新增：代码/DB 之外升级副作用的声明式存放
    - v2.3.0/runtime-env-sync
    - v2.3.0/preferences-structure-migrate
    - v2.3.0/scheduler-prompt-update

calib:
  observability: "request-log-v1"
  throttle_profile: "v1-conservative"
  quota_profile: "v1-conservative"
  content_rules: "2026-04-17"
  emoji_dict_version: "v1"
  spam_keywords_version: "v1"
  docs_format: "keep-a-changelog + upgrade-guide + releasing-sop"
  docs_structure: "adr/plans/runbooks/reference/archive"  # v2.4.0 新增：docs 五子目录重组
  onboarding_polish: "v2.1.3"
  existing_creator_feature: "v2.2.0-mvp"           # 完整路径见 docs/plans/existing-creator-onboarding.md（v2.4.0 docs 重组后新路径）
  schema_drift_validation: "v2.4.0"                # v2.4.0 新增：激活 schemas/ + validate.py
  migration_idempotency: "v2.4.0"                  # v2.4.0 新增：__migrations 表 + _guard.sh
  dependencies_locked: "v2.4.0"                    # v2.4.0 新增：requirements.txt
  install_dep_check: "v2.4.1"                      # v2.4.1 新增：install.sh 补 jq + rsync 依赖检查
  install_env_write_target: "config/runtime.env"   # v2.4.1 修正：从根 .env 的 GEMINI_API_KEY → config/runtime.env 的 IMAGE_GEN_API_KEY
  preflight_mcp_strict: "v2.4.1"                   # v2.4.1 修正：check_mcp 否定信号优先，去掉 state.mcp_configured 掩盖失败的 fallback
  runtime_env_force_override: "v2.4.2"             # v2.4.2 修正：_runtime_env_set 强制覆盖模板默认值（MCP_URL 才能被真写入）
  install_target_db_init: "v2.4.2"                 # v2.4.2 新增：每 target 循环跑 db.sh init，target 的 data/xhs.db 不再 not_initialized
  migration_target_isolation: "v2.4.2"             # v2.4.2 修正：migrations 通过 SHULING_DB 写 target DB 而非源 DB
  db_sh_shuling_db_override: "v2.4.2"              # v2.4.2 新增：db.sh 支持 SHULING_DB env var
  guard_init_propagation: "v2.4.2"                 # v2.4.2 修正：_guard.sh 调 db.sh init 时透传 SHULING_DB
  preflight_upgrade_tolerance: "v2.4.2"            # v2.4.2 修正：ua_step_preflight exit 1/2 视为 runtime 配置未就绪, 不算 upgrade 失败
  pre_submit_gate: "v2.4.2"                        # v2.4.2 新增：scripts/pre-submit-verify.sh 21 项本地回归套件
