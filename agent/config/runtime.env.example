# 薯灵 skill 运行时配置
# 复制为 config/runtime.env 后按需填写
# 注意：本文件不配置 IM/通讯凭证（Telegram 等）—— 那是 hermes-agent 的职责

# ─── 小红书 MCP 服务地址 ──────────────────────────────────────
MCP_URL=http://localhost:18060/mcp

# ─── 图像生成 API（必需）─────────────────────────────────────────
# 薯灵已移除 HTML 截图降级。没有 API Key 就无法生图。
#
# 支持两个模型，二选一（IMAGE_GEN_PROTOCOL 切换）：
#
# ── 选项 A：Gemini 3 Pro（默认，推荐 — 中文渲染稳）─────────
# IMAGE_GEN_PROTOCOL=gemini-native
# IMAGE_GEN_MODEL=gemini-3-pro-image-preview
# IMAGE_GEN_API_KEY=<你的 Gemini Key>
# # Key 申请：https://aistudio.google.com/app/apikey
#
# ── 选项 B：OpenAI gpt-image-2（备选 — 全球可达，需付费）────
# IMAGE_GEN_PROTOCOL=openai-images
# IMAGE_GEN_MODEL=gpt-image-2
# IMAGE_GEN_API_KEY=<你的 OpenAI Key, sk-...>
# # IMAGE_GEN_BASE_URL=https://api.openai.com  # 默认即此值，自定义代理时改
#
# ── 选项 C：通用 OpenAI Chat 兼容代理（高级，自助）─────────
# 例如 newapi/oneapi 反代等，把图像生成包到 chat completion 接口里
# IMAGE_GEN_PROTOCOL=openai-chat
# IMAGE_GEN_BASE_URL=https://your-proxy.example.com
# IMAGE_GEN_MODEL=<代理支持的模型名>
# IMAGE_GEN_API_KEY=<代理 Key>
IMAGE_GEN_API_KEY=

# ─── NoteRx 诊断（可选，默认用 muran 公网地址）────────────────
# NOTERX_API_URL=https://noterx.muran.tech
# NOTERX_TIMEOUT_PRE=15
# NOTERX_TIMEOUT_FULL=150

# ─── 图片品牌风格（已弃用）────────────────────────────
# 旧版用 IMAGE_BRAND_STYLE 把英文设计语境拼到 prompt 前面，实测会把 Gemini
# 拉到欧美 infographic 样本池，生出来像 Notion/Medium 而不像小红书。
# 新版生图已改用 prompts/image_prompt.txt 中文模板，直接锚小红书爆款图文风格，
# 请不要再设这个变量。
# IMAGE_BRAND_STYLE=（已废弃，勿配置）
