# ---- LLM 配置（workflow 脚本的后台 LLM 调用）----
LLM_PROVIDER=claude           # claude | openai | openai-compatible
LLM_API_KEY=
LLM_BASE_URL=                 # 留空用官方默认，填自定义地址覆盖
LLM_MODEL=claude-sonnet-4-20250514

# === 必填 ===
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
XHS_TELEGRAM_BOT_TOKEN=
XHS_TELEGRAM_CHAT_ID=

# === 可选：Claude / Node 路径 ===
XHS_CLAUDE_BIN=claude
XHS_NODE_BIN=node
XHS_NODE_PATH=
MCP_URL=http://localhost:18060

# === 图像生成（可选，未配置则所有图片走 HTML 截图）===
# IMAGE_GEN_PROVIDER 选择生图后端：
#   openai  — OpenAI / 兼容 API（gpt-image-1 等），默认
#   gemini  — Google Gemini API（Nano Banana Pro / Nano Banana 2 等）
IMAGE_GEN_PROVIDER=openai

# -- OpenAI 模式 --
# IMAGE_GEN_API_KEY=sk-xxx
# IMAGE_GEN_BASE_URL=https://api.openai.com/v1
# IMAGE_GEN_MODEL=gpt-image-1
# IMAGE_GEN_SIZE=1024x1024

# -- Gemini 模式 --
# IMAGE_GEN_API_KEY=AIza...            （从 https://aistudio.google.com/api-keys 获取）
# IMAGE_GEN_MODEL=gemini-2.0-flash-preview-image-generation
# IMAGE_GEN_ASPECT_RATIO=3:4           （支持 1:1 / 3:4 / 9:16 / 16:9 等）
#
# 可选模型：
#   gemini-2.0-flash-preview-image-generation  — 免费额度，速度快
#   gemini-2.0-flash-exp                       — 实验版，免费
#   （更多模型请查看 Google AI Studio）

IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=gpt-image-1
IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_ASPECT_RATIO=3:4
IMAGE_GEN_STYLE=vivid
IMAGE_BRAND_STYLE=OpenClaw tech blogger style, warm orange and coral color palette, cute lobster mascot accent, rounded card layout with soft shadows, playful but professional tech illustration, consistent emoji decorations, Xiaohongshu aesthetic with low-saturation warm tones, clean info-card design, no watermark, no text overlay on images

# === 草稿流程 ===
DRAFT_MODE=lite
DRAFT_CONCURRENCY=3
DRAFT_SELECT_TIMEOUT=110
IMAGE_REVIEW_TIMEOUT=30
