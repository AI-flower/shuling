# === 必填 ===
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
XHS_TELEGRAM_BOT_TOKEN=
XHS_TELEGRAM_CHAT_ID=

# === 可选：Claude / Node 路径 ===
XHS_CLAUDE_BIN=claude
XHS_NODE_BIN=node
XHS_NODE_PATH=
MCP_URL=http://localhost:18060

# === 图像生成（可选，未配置则所有图片走 HTML 截图）===
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=gpt-image-1
IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_STYLE=vivid
IMAGE_BRAND_STYLE=OpenClaw tech blogger style, warm orange and coral color palette, cute lobster mascot accent, rounded card layout with soft shadows, playful but professional tech illustration, consistent emoji decorations, Xiaohongshu aesthetic with low-saturation warm tones, clean info-card design, no watermark, no text overlay on images

# === 草稿流程 ===
DRAFT_MODE=lite
DRAFT_CONCURRENCY=3
DRAFT_SELECT_TIMEOUT=110
IMAGE_REVIEW_TIMEOUT=30
