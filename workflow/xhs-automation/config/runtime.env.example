# === 必填 ===
XHS_TELEGRAM_BOT_TOKEN=        # Telegram Bot Token（@BotFather 获取）
XHS_TELEGRAM_CHAT_ID=          # Telegram Chat ID
MCP_URL=http://localhost:18060  # xiaohongshu-mcp 服务地址

# === 可选：Claude / Node 路径（通常不用改）===
# XHS_CLAUDE_BIN=claude
# XHS_NODE_BIN=node
# XHS_NODE_PATH=

# === 可选：图片生成（不配则走 HTML 截图，效果也不错）===
# IMAGE_GEN_PROVIDER=gemini       # openai 或 gemini
# IMAGE_GEN_API_KEY=              # API Key
# IMAGE_GEN_MODEL=gemini-2.0-flash-preview-image-generation
# IMAGE_GEN_SIZE=1024x1024
# IMAGE_GEN_ASPECT_RATIO=3:4

# === 可选：品牌风格（生图时使用）===
# IMAGE_BRAND_STYLE=你的品牌风格描述

# === 可选：草稿流程 ===
# DRAFT_MODE=lite                 # lite（3份）或 pro（8份）
# DRAFT_CONCURRENCY=3
# DRAFT_SELECT_TIMEOUT=110        # 博主选择超时（分钟）
# IMAGE_REVIEW_TIMEOUT=30         # 图片审核超时（分钟）
