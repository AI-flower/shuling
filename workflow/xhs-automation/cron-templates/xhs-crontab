# XHS Automation — 小红书自动化定时任务
# 安装方法：bash cron-templates/install-cron.sh
# 卸载方法：crontab -l | grep -v xhs-automation | grep -v "XHS Automation" | crontab -

# 08:00 晨间选题研究
0  8  * * * cd __WORKDIR__ && python3 scripts/research.py >> logs/research.log 2>&1

# 09:00 内容创作
0  9  * * * cd __WORKDIR__ && python3 scripts/orchestrator.py >> logs/create.log 2>&1

# 11:30 午间发布
30 11 * * * cd __WORKDIR__ && python3 scripts/publish_post.py $(date +\%F) noon >> logs/publish.log 2>&1

# 20:30 晚间发布
30 20 * * * cd __WORKDIR__ && python3 scripts/publish_post.py $(date +\%F) evening >> logs/publish.log 2>&1

# 21:30 预览次日内容
30 21 * * * cd __WORKDIR__ && python3 scripts/send_preview.py >> logs/preview.log 2>&1

# 22:00 晚间复盘
0  22 * * * cd __WORKDIR__ && python3 scripts/review.py >> logs/review.log 2>&1

# 每 4 小时登录保活
0 */4 * * * cd __WORKDIR__ && python3 scripts/keepalive.py >> logs/keepalive.log 2>&1
