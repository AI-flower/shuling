<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yl.xhs-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd __WORKDIR__ &amp;&amp; /usr/bin/python3 scripts/publish_post.py "$(date +%Y-%m-%d)" noon; /usr/bin/python3 scripts/publish_post.py "$(date +%Y-%m-%d)" evening</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>11</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>__WORKDIR__/logs/publish.log</string>
  <key>StandardErrorPath</key>
  <string>__WORKDIR__/logs/publish-error.log</string>
</dict>
</plist>
